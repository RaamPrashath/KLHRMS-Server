DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@HOST/DATABASE"

MODE="production"
APP_ENV="production"
APP_PORT=8000
API_V1_PREFIX="/api/v1"
DEBUG=false

# Include your exact Vercel production URL here. The regex also allows Vercel previews.
CORS_ORIGINS="https://klhrms.vercel.app,http://localhost:3000,http://127.0.0.1:3000"
CORS_ORIGIN_REGEX="https://.*\\.vercel\\.app"
ALLOWED_HOSTS="klhrms-server.onrender.com,localhost,127.0.0.1,testserver"

# Used for email links back to the frontend.
PUBLIC_APP_URL="https://klhrms.vercel.app"
BETTER_AUTH_URL="https://klhrms.vercel.app"

CALENDARIFIC_API_KEY=""
RESEND_API_KEY=""
# Resend's resend.dev sender is for sandbox testing only. To email arbitrary
# recipients in production, replace this with an address on a verified domain.
RESEND_FROM_EMAIL="Kovan Labs <onboarding@resend.dev>"
SECONDARY_RECEIVER=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_OFFER_BUCKET="offer-letter"
SUPABASE_ONBOARDING_BUCKET="onboarding-documents"
SUPABASE_PROCUREMENT_PO_BUCKET="procurement-purchase-orders"
